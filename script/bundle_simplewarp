#!/usr/bin/env bash
#
# Build and bundle the SimpleWarp app: builds the `simplewarp` bin, wraps it in a
# minimal .app (so it gets a Dock icon and can be Finder-launched), and compiles
# in the real Warp icon.
#
# This deliberately does NOT use script/bundle: that pipeline needs the private
# warp-channel-config repo (no SSH access in this fork) plus GCP-secret-backed
# notarization credentials SimpleWarp doesn't have or need for local use.
#
# Usage: script/bundle_simplewarp [--debug]

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

PROFILE=release
CARGO_ARGS=(--release)
if [[ "${1:-}" == "--debug" ]]; then
  PROFILE=debug
  CARGO_ARGS=()
fi

export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode-beta.app/Contents/Developer}"

cargo build "${CARGO_ARGS[@]}" --no-default-features --features simplewarp --bin simplewarp

APP="target/$PROFILE/SimpleWarp.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "target/$PROFILE/simplewarp" "$APP/Contents/MacOS/simplewarp"

# Keep in sync with the embedded Info.plist in app/src/bin/simplewarp.rs, plus
# the CFBundleIconFile/CFBundleIconName keys script/compile_icon needs.
cat > "$APP/Contents/Info.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>CFBundleDevelopmentRegion</key>
<string>English</string>
<key>CFBundleDisplayName</key>
<string>SimpleWarp</string>
<key>CFBundleExecutable</key>
<string>simplewarp</string>
<key>CFBundleIdentifier</key>
<string>dev.simplewarp.SimpleWarp</string>
<key>CFBundleInfoDictionaryVersion</key>
<string>6.0</string>
<key>CFBundleName</key>
<string>SimpleWarp</string>
<key>CFBundlePackageType</key>
<string>APPL</string>
<key>CFBundleShortVersionString</key>
<string>0.1.0</string>
<key>LSApplicationCategoryType</key>
<string>public.app-category.developer-tools</string>
<key>NSHighResolutionCapable</key>
<true/>
<key>UIDesignRequiresCompatibility</key>
<true/>
<key>CFBundleURLTypes</key>
<array><dict><key>CFBundleURLName</key><string>Custom App</string><key>CFBundleURLSchemes</key><array><string>simplewarp</string></array></dict></array>
</dict>
</plist>
EOF

script/compile_icon stable "$APP"
codesign --force --deep -s - "$APP"

echo "Built $APP"
