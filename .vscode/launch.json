{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "attach",
      "name": "Debug already-running process",
      "pid": "${command:pickMyProcess}",
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'warp-oss'",
      "cargo": {
        "args": [
          "build",
          "--bin=warp-oss"
        ],
        "filter": {
          "name": "warp-oss",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug MacOS executable",
      "preLaunchTask": "build_warposs",
      "program": "${workspaceFolder}/target/debug/bundle/osx/WarpOss.app/Contents/MacOS/warp-oss",
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'warp'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--package=warp"
        ],
        "filter": {
          "name": "warp",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug integration tests in executable 'integration'",
      "cargo": {
        "args": [
          "build",
          "--bin=integration",
          "--package=warp"
        ],
        "env": {
          "WARPUI_USE_REAL_DISPLAY_IN_INTEGRATION_TESTS": "1"
        },
        "filter": {
          "name": "integration",
          "kind": "bin"
        }
      },
      "args": [
        "test_waterfall_input"
      ],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'warpui'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--package=warpui"
        ],
        "filter": {
          "name": "warpui",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": [
        "rust"
      ]
    }
  ]
}
