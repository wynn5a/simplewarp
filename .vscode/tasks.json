{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Watch",
            "group": "build",
            "type": "shell",
            "command": "cargo watch",
            "problemMatcher": "$rustc-watch",
            "isBackground": true
        },
        {
            "type": "cargo",
            "command": "build",
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "rust: cargo build"
        },
        {
            "type": "shell",
            "command": "./script/run --dont-open",
            "label": "build_warposs"
        }
    ]
}
